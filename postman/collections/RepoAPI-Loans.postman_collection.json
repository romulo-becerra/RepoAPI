{
  "info": {
    "_postman_id": "2f7791bf-d66d-4a9a-9f26-e93fe23be2fd",
    "name": "RepoAPI - Loans",
    "description": "Collection for loan APIs with auth bootstrap and dynamic variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Loan\",\n  \"last_name\": \"Tester\",\n  \"email\": \"loan.tester+{{$timestamp}}@example.com\",\n  \"phone\": \"{{phone}}\",\n  \"pin\": \"{{pin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register status 201', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "if (json.token) { pm.environment.set('token', json.token); }",
                  "if (json.user && json.user.id) { pm.environment.set('user_id', json.user.id); }",
                  "if (json.user && json.user.role) { pm.environment.set('user_role', json.user.role); }",
                  "if (json.account && json.account.account_number) { pm.environment.set('account_number', json.account.account_number); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_number\": \"{{account_number}}\",\n  \"pin\": \"{{pin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login status 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('token', json.token);",
                  "if (json.user && json.user.id) { pm.environment.set('user_id', json.user.id); }",
                  "if (json.user && json.user.role) { pm.environment.set('user_role', json.user.role); }",
                  "if (json.account && json.account.id) { pm.environment.set('account_id', json.account.id); }",
                  "if (json.account && json.account.account_number) { pm.environment.set('account_number', json.account.account_number); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
