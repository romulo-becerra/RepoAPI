    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"API\",\n  \"last_name\": \"User\",\n  \"email\": \"api.user+{{$timestamp}}@example.com\",\n  \"phone\": \"{{phone}}\",\n  \"pin\": \"{{pin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.token) pm.environment.set('token', j.token);",
                  "if (j.user && j.user.id) pm.environment.set('user_id', j.user.id);",
                  "if (j.account && j.account.id) pm.environment.set('account_id', j.account.id);",
                  "if (j.account && j.account.account_number) pm.environment.set('account_number', j.account.account_number);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_number\": \"{{account_number}}\",\n  \"pin\": \"{{pin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.token) pm.environment.set('token', j.token);",
                  "if (j.user && j.user.id) pm.environment.set('user_id', j.user.id);",
                  "if (j.account && j.account.id) pm.environment.set('account_id', j.account.id);"
                ]
              }
            }
          ]
        },
