{
  "info": {
    "_postman_id": "9baf3e03-4d4f-4dcf-8aa4-9fb9a0ad82d9",
    "name": "RepoAPI - User Admin Upload",
    "description": "Collection for user profile (phone/address), manager user CRUD, and file upload APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User with Phone",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"User\",\n  \"last_name\": \"WithPhone\",\n  \"email\": \"user.with.phone+{{$timestamp}}@example.com\",\n  \"phone\": \"{{phone}}\",\n  \"pin\": \"{{pin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () { pm.response.to.have.status(201); });",
                  "var j = pm.response.json();",
                  "if (j.token) pm.environment.set('token', j.token);",
                  "if (j.user && j.user.id) pm.environment.set('user_id', j.user.id);",
                  "if (j.account && j.account.account_number) pm.environment.set('account_number', j.account.account_number);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_number\": \"{{account_number}}\",\n  \"pin\": \"{{pin}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json();",
                  "pm.environment.set('token', j.token);",
                  "if (j.user && j.user.id) pm.environment.set('user_id', j.user.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "User Address",
      "item": [
        {
          "name": "Upsert Address",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Peru\",\n  \"city\": \"Lima\",\n  \"province\": \"Lima\",\n  \"street\": \"Av Central\",\n  \"street_number\": \"123\",\n  \"district\": \"Miraflores\",\n  \"postal_code\": \"15074\",\n  \"reference\": \"Frente al parque\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{user_id}}/address",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{user_id}}", "address"]
            }
          }
        },
        {
          "name": "Get Address",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{user_id}}/address",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{user_id}}", "address"]
            }
          }
        }
      ]
    },
    {
      "name": "User Files",
      "item": [
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{user_id}}/files",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{user_id}}", "files"]
            }
          }
        },
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{user_id}}/files",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{user_id}}", "files"]
            }
          }
        }
      ]
    },
    {
      "name": "Manager Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/manager/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manager", "users"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{manager_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Managed\",\n  \"last_name\": \"User\",\n  \"email\": \"managed.user+{{$timestamp}}@example.com\",\n  \"phone\": \"+51997123456\",\n  \"pin\": \"1234\",\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/manager/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manager", "users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.user && j.user.id) pm.environment.set('managed_user_id', j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{manager_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/manager/users/{{managed_user_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "manager", "users", "{{managed_user_id}}"]
            }
          }
        }
      ]
    }
  ]
}
